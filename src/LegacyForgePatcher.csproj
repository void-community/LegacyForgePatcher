<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <JvmBridgeAgent>true</JvmBridgeAgent>
    <PublishAot>true</PublishAot>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <Description>A native JVM agent that lets Forge for Minecraft 1.7.2 launch on Java 8u20 and later.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JvmBridge" />
    <JavaSource Include="java/**/*.java" />
    <InternalsVisibleTo Include="LegacyForgePatcher.Tests" />
  </ItemGroup>
</Project>
