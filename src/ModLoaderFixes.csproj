<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <JvmBridgeAgent>true</JvmBridgeAgent>
    <PublishAot>true</PublishAot>
    <!-- Compiling the Java helpers needs a JDK; this downloads a pinned one when JvmBridgeJdkHome and JAVA_HOME name none. -->
    <JvmBridgeProvisionJdk>true</JvmBridgeProvisionJdk>
    <!-- Publishing also writes ModLoaderFixes.jar beside the library, a jar for java -javaagent that holds the library of the published platform. -->
    <JvmBridgeAgentJar>true</JvmBridgeAgentJar>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <Description>A native JVM agent that fixes Forge, NeoForge and Minecraft servers and clients where their own code breaks.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JvmBridge" />
    <JavaSource Include="java/**/*.java" />
    <!-- Stand-ins for the game's classes that the helpers compile against; the JVM links the helpers to the real ones, so these are never shipped. -->
    <JavaStubSource Include="stubs/**/*.java" />
    <InternalsVisibleTo Include="ModLoaderFixes.Tests" />
  </ItemGroup>
</Project>
